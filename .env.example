# Authentication (shared by both services)
# When set, all endpoints except the health checks (/stats and /health)
# require an "X-API-Key: <key>" request header. Leave empty to disable
# authentication (not recommended for public deployments).
# Generate one with: openssl rand -hex 32
API_KEY=

# Host interface to publish the service ports on.
# Defaults to 127.0.0.1 (loopback only) so the services are not exposed on
# all interfaces. Set to 0.0.0.0 only if you need direct external access.
BIND_HOST=127.0.0.1

# Scraper Configuration
SCRAPER_PORT=5001
SCRAPER_CACHE_DURATION=60
SCRAPER_RATE_LIMIT=2

# Screener Configuration
SCREENER_PORT=5002
SCREENER_CACHE_DURATION=60
SCREENER_CLEANUP_HOURS=24

# Optional: Custom paths
# SCREENSHOT_DIR=/tmp/screener_screenshots
